 "captions": [
  {
   "start": 0.45,
   "end": 1.6,
   "text": "Here's a fictional founder:"
  },
  {
   "start": 1.89,
   "end": 4.15,
   "text": "a hardware startup in Japan, at pre-seed,"
  },
  {
   "start": 4.15,
   "end": 7.96,
   "text": "looking for about $150,000 from one investor."
  },
  {
   "start": 8.53,
   "end": 10.75,
   "text": "Today, Startup Tarot compares that"
  },
  {
   "start": 10.75,
   "end": 12.92,
   "text": "with two real investors' public criteria."
  },
  {
   "start": 13.46,
   "end": 15.64,
   "text": "Monozukuri Ventures matches all four:"
  },
  {
   "start": 16,
   "end": 18.73,
   "text": "stage, sector, location and check size."
  },
  {
   "start": 19.24,
   "end": 22.09,
   "text": "For Geek Ventures, only the stage matches."
  },
  {
   "start": 22.41,
   "end": 24.47,
   "text": "Its sector and check size aren't documented,"
  },
  {
   "start": 24.61,
   "end": 26.46,
   "text": "and it focuses on US businesses."
  },
  {
   "start": 26.75,
   "end": 28.43,
   "text": "The app says so instead of guessing."
  },
  {
   "start": 29.12,
   "end": 31.15,
   "text": "Now ask: who in our network"
  },
  {
   "start": 31.15,
   "end": 33.1,
   "text": "could introduce this founder to Monozukuri?"
  },
  {
   "start": 33.68,
   "end": 36.34,
   "text": "Today the answer is: no connection documented."
  },
  {
   "start": 36.68,
   "end": 39.02,
   "text": "We don't guess relationships from public pages."
  },
  {
   "start": 39.4,
   "end": 42.54,
   "text": "In the pilot, your team adds connections it can confirm,"
  },
  {
   "start": 42.88,
   "end": 44.44,
   "text": "each with a source and a date."
  },
  {
   "start": 44.96,
   "end": 46.66,
   "text": "Then the same question gets a real answer:"
  },
  {
   "start": 47.03,
   "end": 48.45,
   "text": "a good fit, and a sourced path"
  },
  {
   "start": 48.45,
   "end": 50.24,
   "text": "to someone who can make the introduction."
  }
 ],
